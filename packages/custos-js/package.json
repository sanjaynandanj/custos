{
  "name": "custos-mcp",
  "version": "0.4.0",
  "description": "Runtime governance, policy enforcement, and cryptographic audit ledger for MCP tool calls",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "custos": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./proxy": {
      "types": "./dist/proxy.d.ts",
      "import": "./dist/proxy.js"
    },
    "./dashboard": {
      "types": "./dist/dashboard.d.ts",
      "import": "./dist/dashboard.js"
    },
    "./otel": {
      "types": "./dist/otel.d.ts",
      "import": "./dist/otel.js"
    },
    "./adapters/langgraph": {
      "types": "./dist/adapters/langgraph.d.ts",
      "import": "./dist/adapters/langgraph.js"
    },
    "./adapters/claude-agent": {
      "types": "./dist/adapters/claude-agent.d.ts",
      "import": "./dist/adapters/claude-agent.js"
    },
    "./adapters/webmcp": {
      "types": "./dist/adapters/webmcp.d.ts",
      "import": "./dist/adapters/webmcp.js"
    }
  },
  "files": ["dist", "src", "README.md"],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts src/proxy.ts src/dashboard.ts src/otel.ts src/adapters/langgraph.ts src/adapters/claude-agent.ts src/adapters/webmcp.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm test && npm run build"
  },
  "keywords": ["mcp", "governance", "policy", "audit", "ed25519", "ledger", "ai-agents", "langgraph", "claude-agent-sdk"],
  "author": "Custos contributors",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/sanjaynandanj/custos.git", "directory": "packages/custos-js" },
  "homepage": "https://github.com/sanjaynandanj/custos#readme",
  "bugs": { "url": "https://github.com/sanjaynandanj/custos/issues" },
  "engines": { "node": ">=18" },
  "peerDependencies": {
    "@langchain/langgraph": "*",
    "@opentelemetry/api": "*"
  },
  "peerDependenciesMeta": {
    "@langchain/langgraph": { "optional": true },
    "@opentelemetry/api": { "optional": true }
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.4.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
