{
  "name": "custos-telemetry",
  "version": "0.1.0",
  "private": true,
  "description": "Anonymous install/usage receiver for custos-mcp — Cloudflare Worker + D1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:apply:local": "wrangler d1 execute custos-telemetry --local --file=./migrations/0001_init.sql",
    "db:apply:remote": "wrangler d1 execute custos-telemetry --remote --file=./migrations/0001_init.sql",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260101.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "^3.90.0"
  }
}
